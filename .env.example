# App Environment
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=sqlite:///./video_post.db

# YouTube Data API v3 Credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8080/oauth2callback
YOUTUBE_TOKEN_PATH=./config/tokens/youtube_token.json

# Facebook Graph API Credentials (for Facebook Pages)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_ACCESS_TOKEN=your_long_lived_facebook_page_access_token

# Instagram Graph API Credentials (for Instagram Business/Creator Account)
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_user_access_token

# AI Engine Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RPM_DELAY=4
GEMINI_MAX_RPD=500

# Master Output Sheet Configuration
MASTER_SHEET_URL=https://docs.google.com/spreadsheets/d/1Xg67qhp1J_Izt7v5uDKRgKjdEZapX9giKJ_ym0OMJN4/


# Media Storage Configuration
INPUT_VIDEOS_DIR=./input_videos
PROCESSED_VIDEOS_DIR=./processed_videos

# Notification / Alerting Configuration
SLACK_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENT=
